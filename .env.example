# ──────────────────────────────────────────────────────────────────────────
# Health Plan Optimizer — environment variables
# Copy to `.env` (in backend/) and fill in. Never commit the real .env.
# ──────────────────────────────────────────────────────────────────────────

# ── LLM provider ───────────────────────────────────────────────────────────
# Which provider the LLMProvider factory uses by default. One of: gemini | openai
LLM_PROVIDER=gemini

# Gemini (default). Get a key: https://aistudio.google.com/
GEMINI_API_KEY=AIza...
# Default models per tier. Reasoning-heavy agents use the "strong" model;
# cheap/fast agents (e.g. macro formatting) can use the "fast" model.
LLM_MODEL_STRONG=gemini-2.5-pro
LLM_MODEL_FAST=gemini-2.5-flash

# OpenAI (optional — only if LLM_PROVIDER=openai). Provider abstraction supports it.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL_STRONG=gpt-4o
# OPENAI_MODEL_FAST=gpt-4o-mini

# ── Real external tools ────────────────────────────────────────────────────
# USDA FoodData Central — free API key: https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=DEMO_KEY

# Web search — pick whichever the web-search tool is implemented against.
# Tavily (recommended, simple): https://tavily.com/
TAVILY_API_KEY=tvly-...
# (Alternative) Serper / SerpAPI etc. — see backend/app/tools/web_search.py
# SERPER_API_KEY=

# Grocery / price data. If no provider is configured, the Budget Agent's price
# tool falls back to a seeded local price table (data/seed_prices.json).
# Set USE_SEEDED_PRICES=true to force the deterministic fallback (good for demos).
USE_SEEDED_PRICES=true
# PRICE_API_KEY=

# ── App config ─────────────────────────────────────────────────────────────
# Max debate/refinement rounds before the Resolver must finalize (safety bound).
MAX_REFINEMENT_ROUNDS=3
# CORS origin for the frontend dev server.
FRONTEND_ORIGIN=http://localhost:5173
# Backend host/port.
API_HOST=0.0.0.0
API_PORT=8000
# Log level: DEBUG | INFO | WARNING
LOG_LEVEL=INFO
